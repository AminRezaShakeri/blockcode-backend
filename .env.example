NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_CA=

# In development, verification links are printed to the terminal.
# For a deployed site, use MAIL_MODE=smtp and configure SMTP_URL + SMTP_FROM.
MAIL_MODE=console
ALLOW_DEVELOPMENT_VERIFICATION_LINKS=false
SMTP_URL=
SMTP_FROM=BlokCode <no-reply@example.com>

# Keep payments disabled until a merchant ID is configured.
PAYMENTS_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Card-to-card orders remain disabled until explicitly configured.
CARD_TRANSFER_ENABLED=false
CARD_TRANSFER_CARD_NUMBER=
CARD_TRANSFER_CARD_HOLDER=
